// EFFICACY SCORE ADJUSTMENTS

rule "Efficacy adjustment - base self efficacy"
salience 100
when
    $e : DailyCheckInEvent(
        $sid : studentId,
        $day : dayIndex,
        $efficacy : efficacy
    )
    not ScoreAdjustment(
        studentId == $sid,
        dayIndex == $day,
        dimension == "EFFICACY",
        reason == "BASE_SELF_EFFICACY"
    )
then
    insert(new ScoreAdjustment($sid, $day, "EFFICACY", "BASE_SELF_EFFICACY", $efficacy));
end

rule "Efficacy adjustment - low concentration"
salience 100
when
    $e : DailyCheckInEvent(
        $sid : studentId,
        $day : dayIndex,
        concentration <= 3
    )
    not ScoreAdjustment(
        studentId == $sid,
        dayIndex == $day,
        dimension == "EFFICACY",
        reason == "LOW_CONCENTRATION"
    )
then
    insert(new ScoreAdjustment($sid, $day, "EFFICACY", "LOW_CONCENTRATION", -1));
end

rule "Efficacy adjustment - missed obligation"
salience 100
when
    $e : DailyCheckInEvent(
        $sid : studentId,
        $day : dayIndex,
        missedObligation == true
    )
    not ScoreAdjustment(
        studentId == $sid,
        dayIndex == $day,
        dimension == "EFFICACY",
        reason == "MISSED_OBLIGATION"
    )
then
    insert(new ScoreAdjustment($sid, $day, "EFFICACY", "MISSED_OBLIGATION", -1));
end


// FINAL SCORE FACTS

rule "Create exhaustion score from adjustments"
salience 80
when
    $e : DailyCheckInEvent($sid : studentId, $day : dayIndex)
    $total : Number() from accumulate(
        ScoreAdjustment(
            studentId == $sid,
            dayIndex == $day,
            dimension == "EXHAUSTION",
            $value : value
        ),
        sum($value)
    )
    not ExhaustionScore(studentId == $sid, dayIndex == $day)
then
    insert(new ExhaustionScore($sid, $day, $total.intValue()));
end

rule "Create cynicism score from adjustments"
salience 80
when
    $e : DailyCheckInEvent($sid : studentId, $day : dayIndex)
    $total : Number() from accumulate(
        ScoreAdjustment(
            studentId == $sid,
            dayIndex == $day,
            dimension == "CYNICISM",
            $value : value
        ),
        sum($value)
    )
    not CynicismScore(studentId == $sid, dayIndex == $day)
then
    insert(new CynicismScore($sid, $day, $total.intValue()));
end

rule "Create efficacy score from adjustments"
salience 80
when
    $e : DailyCheckInEvent($sid : studentId, $day : dayIndex)
    $total : Number() from accumulate(
        ScoreAdjustment(
            studentId == $sid,
            dayIndex == $day,
            dimension == "EFFICACY",
            $value : value
        ),
        sum($value)
    )
    not EfficacyScore(studentId == $sid, dayIndex == $day)
then
    insert(new EfficacyScore($sid, $day, $total.intValue()));
end

rule "Normalize efficacy score minimum"
salience 75
when
    $s : EfficacyScore(value < 1)
then
    modify($s) {
        setValue(1)
    }
end


// SCORE SNAPSHOT EVENT

rule "Create score snapshot event"
salience 70
when
    $e : DailyCheckInEvent(
        $sid : studentId,
        $day : dayIndex,
        $timestamp : timestamp
    )
    $ex : ExhaustionScore(studentId == $sid, dayIndex == $day)
    $cy : CynicismScore(studentId == $sid, dayIndex == $day)
    $ef : EfficacyScore(studentId == $sid, dayIndex == $day)
    not ScoreSnapshotEvent(studentId == $sid, dayIndex == $day)
then
    insert(new ScoreSnapshotEvent(
        $sid,
        $timestamp,
        $day,
        $ex.getValue(),
        $cy.getValue(),
        $ef.getValue()
    ));
end
