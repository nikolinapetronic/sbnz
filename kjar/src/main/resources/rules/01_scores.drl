// CYNICISM SCORE ADJUSTMENTS

rule "Cynicism adjustment - low motivation"
salience 100
when
    $e : DailyCheckInEvent(
        $sid : studentId,
        $day : dayIndex,
        motivation <= 3
    )
    not ScoreAdjustment(
        studentId == $sid,
        dayIndex == $day,
        dimension == "CYNICISM",
        reason == "LOW_MOTIVATION"
    )
then
    insert(new ScoreAdjustment($sid, $day, "CYNICISM", "LOW_MOTIVATION", 4));
end

rule "Cynicism adjustment - low study meaning"
salience 100
when
    $e : DailyCheckInEvent(
        $sid : studentId,
        $day : dayIndex,
        studyMeaning > 0,
        studyMeaning <= 3
    )
    not ScoreAdjustment(
        studentId == $sid,
        dayIndex == $day,
        dimension == "CYNICISM",
        reason == "LOW_STUDY_MEANING"
    )
then
    insert(new ScoreAdjustment($sid, $day, "CYNICISM", "LOW_STUDY_MEANING", 2));
end

