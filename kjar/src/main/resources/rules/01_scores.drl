package rules

import com.sbnz.model.enums.CopingStrategy;
import com.sbnz.model.enums.SleepQuality;

import com.sbnz.model.events.DailyCheckInEvent;
import com.sbnz.model.events.ScoreSnapshotEvent;
import com.sbnz.model.profile.ThresholdProfile;

import com.sbnz.model.scores.ScoreAdjustment;
import com.sbnz.model.scores.ExhaustionScore;
import com.sbnz.model.scores.CynicismScore;
import com.sbnz.model.scores.EfficacyScore;


// EXHAUSTION SCORE ADJUSTMENTS

rule "Exhaustion adjustment - poor sleep duration"
salience 100
when
    $t : ThresholdProfile($sid : studentId)
    $e : DailyCheckInEvent(
        studentId == $sid,
        $day : dayIndex,
        sleepHours < $t.minSleepHours
    )
    not ScoreAdjustment(
        studentId == $sid,
        dayIndex == $day,
        dimension == "EXHAUSTION",
        reason == "POOR_SLEEP_DURATION"
    )
then
    insert(new ScoreAdjustment($sid, $day, "EXHAUSTION", "POOR_SLEEP_DURATION", 3));
end

rule "Exhaustion adjustment - poor sleep quality"
salience 100
when
    $e : DailyCheckInEvent(
        $sid : studentId,
        $day : dayIndex,
        sleepQuality == SleepQuality.POOR
    )
    not ScoreAdjustment(
        studentId == $sid,
        dayIndex == $day,
        dimension == "EXHAUSTION",
        reason == "POOR_SLEEP_QUALITY"
    )
then
    insert(new ScoreAdjustment($sid, $day, "EXHAUSTION", "POOR_SLEEP_QUALITY", 1));
end

rule "Exhaustion adjustment - high stress"
salience 100
when
    $t : ThresholdProfile($sid : studentId)
    $e : DailyCheckInEvent(
        studentId == $sid,
        $day : dayIndex,
        stress >= $t.highStressThreshold
    )
    not ScoreAdjustment(
        studentId == $sid,
        dayIndex == $day,
        dimension == "EXHAUSTION",
        reason == "HIGH_STRESS"
    )
then
    insert(new ScoreAdjustment($sid, $day, "EXHAUSTION", "HIGH_STRESS", 3));
end

rule "Exhaustion adjustment - high fatigue"
salience 100
