package rules;
import com.sbnz.model.context.StudentContext;
import com.sbnz.model.profile.ThresholdProfile;
import com.sbnz.model.enums.StudentProfile;
import com.sbnz.model.enums.AcademicPeriod;

rule "Create threshold profile DEFAULT REGULAR_CLASSES"
salience 200
when
    StudentContext(
        $sid : studentId,
        profileType == StudentProfile.DEFAULT,
        academicPeriod == AcademicPeriod.REGULAR_CLASSES
    )
    not ThresholdProfile(studentId == $sid)
then
    insert(new ThresholdProfile(
        $sid,
        StudentProfile.DEFAULT,
        AcademicPeriod.REGULAR_CLASSES,
        6,
        7,
        4,
        2,
        5,
        5
    ));
end

