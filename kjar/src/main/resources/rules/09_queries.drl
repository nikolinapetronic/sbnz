package rules

import com.sbnz.model.evidence.EvidenceNode;
import com.sbnz.model.evidence.EvidenceRelation;

import com.sbnz.model.indicators.ExhaustionIndicator;
import com.sbnz.model.indicators.CynicismIndicator;
import com.sbnz.model.indicators.ReducedEfficacyIndicator;

import com.sbnz.model.patterns.SustainedStressPattern;
import com.sbnz.model.patterns.SustainedPoorSleepPattern;
import com.sbnz.model.patterns.LowRecoveryPattern;
import com.sbnz.model.patterns.AvoidancePattern;
import com.sbnz.model.patterns.AcademicGoalDeviationPattern;
import com.sbnz.model.patterns.RepeatedLowMotivationPattern;
import com.sbnz.model.patterns.NegativeTrend;


// EVIDENCE RELATION HIJERARHIJA
// ove cinjenice definisu graf znanja koji je koriscen od strane rekurzivnog backward chaining-a

rule "Evidence relation - exhaustion indicator to core evidence"
salience 20
when
    not EvidenceRelation(child == "ExhaustionIndicator", parent == "CoreBurnoutEvidence")
then
    insert(new EvidenceRelation("ExhaustionIndicator", "CoreBurnoutEvidence"));
end

rule "Evidence relation - cynicism indicator to core evidence"
salience 20
when
    not EvidenceRelation(child == "CynicismIndicator", parent == "CoreBurnoutEvidence")
then
    insert(new EvidenceRelation("CynicismIndicator", "CoreBurnoutEvidence"));
end

rule "Evidence relation - reduced efficacy indicator to core evidence"
salience 20
when
    not EvidenceRelation(child == "ReducedEfficacyIndicator", parent == "CoreBurnoutEvidence")
then
    insert(new EvidenceRelation("ReducedEfficacyIndicator", "CoreBurnoutEvidence"));
end

rule "Evidence relation - sustained poor sleep to chronicity evidence"
salience 20
when
    not EvidenceRelation(child == "SustainedPoorSleepPattern", parent == "ChronicityEvidence")
then
    insert(new EvidenceRelation("SustainedPoorSleepPattern", "ChronicityEvidence"));
end

