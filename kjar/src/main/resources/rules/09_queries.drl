    insert(new EvidenceRelation("AvoidancePattern", "AcademicImpactEvidence"));
end

rule "Evidence relation - academic goal deviation to academic impact evidence"
salience 20
when
    not EvidenceRelation(child == "AcademicGoalDeviationPattern", parent == "AcademicImpactEvidence")
then
    insert(new EvidenceRelation("AcademicGoalDeviationPattern", "AcademicImpactEvidence"));
end

rule "Evidence relation - negative trend to academic impact evidence"
salience 20
when
    not EvidenceRelation(child == "NegativeTrend", parent == "AcademicImpactEvidence")
then
    insert(new EvidenceRelation("NegativeTrend", "AcademicImpactEvidence"));
end

rule "Evidence relation - core evidence to burnout evidence"
salience 20
when
    not EvidenceRelation(child == "CoreBurnoutEvidence", parent == "BurnoutEvidence")
then
    insert(new EvidenceRelation("CoreBurnoutEvidence", "BurnoutEvidence"));
end

rule "Evidence relation - chronicity evidence to burnout evidence"
salience 20
when
    not EvidenceRelation(child == "ChronicityEvidence", parent == "BurnoutEvidence")
then
    insert(new EvidenceRelation("ChronicityEvidence", "BurnoutEvidence"));
end

rule "Evidence relation - academic impact evidence to burnout evidence"
salience 20
when
    not EvidenceRelation(child == "AcademicImpactEvidence", parent == "BurnoutEvidence")
then
    insert(new EvidenceRelation("AcademicImpactEvidence", "BurnoutEvidence"));
