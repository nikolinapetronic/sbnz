salience 20
when
    not EvidenceRelation(child == "BurnoutEvidence", parent == "AcademicBurnoutPattern")
then
    insert(new EvidenceRelation("BurnoutEvidence", "AcademicBurnoutPattern"));
end


// EVIDENCE NODES IZ FORWARD CHAINING CINJENICA
// ova pravila transformisu konkretne cinjenice u genericke evidence nodes koji su korisceni u backward chaining-u

rule "Evidence node - exhaustion indicator"
salience 15
when
    ExhaustionIndicator($sid : studentId)
    not EvidenceNode(studentId == $sid, name == "ExhaustionIndicator")
then
    insert(new EvidenceNode($sid, "ExhaustionIndicator"));
end

rule "Evidence node - cynicism indicator"
salience 15
when
    CynicismIndicator($sid : studentId)
    not EvidenceNode(studentId == $sid, name == "CynicismIndicator")
then
    insert(new EvidenceNode($sid, "CynicismIndicator"));
end

rule "Evidence node - reduced efficacy indicator"
salience 15
when
    ReducedEfficacyIndicator($sid : studentId)
    not EvidenceNode(studentId == $sid, name == "ReducedEfficacyIndicator")
then
    insert(new EvidenceNode($sid, "ReducedEfficacyIndicator"));
end

rule "Evidence node - sustained poor sleep pattern"
salience 15
when
    SustainedPoorSleepPattern($sid : studentId)
    not EvidenceNode(studentId == $sid, name == "SustainedPoorSleepPattern")
then
    insert(new EvidenceNode($sid, "SustainedPoorSleepPattern"));
end

rule "Evidence node - sustained stress pattern"
salience 15
when
    SustainedStressPattern($sid : studentId)
    not EvidenceNode(studentId == $sid, name == "SustainedStressPattern")
then
