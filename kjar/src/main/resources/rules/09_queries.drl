rule "Evidence node - avoidance pattern"
salience 15
when
    AvoidancePattern($sid : studentId)
    not EvidenceNode(studentId == $sid, name == "AvoidancePattern")
then
    insert(new EvidenceNode($sid, "AvoidancePattern"));
end

rule "Evidence node - academic goal deviation pattern"
salience 15
when
    AcademicGoalDeviationPattern($sid : studentId)
    not EvidenceNode(studentId == $sid, name == "AcademicGoalDeviationPattern")
then
    insert(new EvidenceNode($sid, "AcademicGoalDeviationPattern"));
end

rule "Evidence node - negative trend"
salience 15
when
    NegativeTrend($sid : studentId)
    not EvidenceNode(studentId == $sid, name == "NegativeTrend")
then
    insert(new EvidenceNode($sid, "NegativeTrend"));
end


// GROUPNI EVIDENCE NODES
// ova pravila kreiraju higher-level evidence samo kad trazeni lower-level evidence postoji

rule "Evidence node - core burnout evidence"
salience 10
when
    EvidenceNode($sid : studentId, name == "ExhaustionIndicator")
    EvidenceNode(studentId == $sid, name == "CynicismIndicator")
    EvidenceNode(studentId == $sid, name == "ReducedEfficacyIndicator")
    not EvidenceNode(studentId == $sid, name == "CoreBurnoutEvidence")
then
    insert(new EvidenceNode($sid, "CoreBurnoutEvidence"));
end

rule "Evidence node - chronicity evidence from poor sleep and stress"
salience 10
when
    EvidenceNode($sid : studentId, name == "SustainedPoorSleepPattern")
    EvidenceNode(studentId == $sid, name == "SustainedStressPattern")
    not EvidenceNode(studentId == $sid, name == "ChronicityEvidence")
then
    insert(new EvidenceNode($sid, "ChronicityEvidence"));
end

rule "Evidence node - chronicity evidence from poor sleep and low recovery"
salience 10
when
    EvidenceNode($sid : studentId, name == "SustainedPoorSleepPattern")
    EvidenceNode(studentId == $sid, name == "LowRecoveryPattern")
    not EvidenceNode(studentId == $sid, name == "ChronicityEvidence")
then
    insert(new EvidenceNode($sid, "ChronicityEvidence"));
end

rule "Evidence node - chronicity evidence from stress and low recovery"
salience 10
when
    EvidenceNode($sid : studentId, name == "SustainedStressPattern")
    EvidenceNode(studentId == $sid, name == "LowRecoveryPattern")
    not EvidenceNode(studentId == $sid, name == "ChronicityEvidence")
then
    insert(new EvidenceNode($sid, "ChronicityEvidence"));
end

rule "Evidence node - academic impact evidence from avoidance"
salience 10
when
    EvidenceNode($sid : studentId, name == "AvoidancePattern")
    not EvidenceNode(studentId == $sid, name == "AcademicImpactEvidence")
then
    insert(new EvidenceNode($sid, "AcademicImpactEvidence"));
end

rule "Evidence node - academic impact evidence from academic goal deviation"
salience 10
when
    EvidenceNode($sid : studentId, name == "AcademicGoalDeviationPattern")
    not EvidenceNode(studentId == $sid, name == "AcademicImpactEvidence")
then
    insert(new EvidenceNode($sid, "AcademicImpactEvidence"));
end

rule "Evidence node - academic impact evidence from negative trend"
salience 10
when
    EvidenceNode($sid : studentId, name == "NegativeTrend")
    not EvidenceNode(studentId == $sid, name == "AcademicImpactEvidence")
then
    insert(new EvidenceNode($sid, "AcademicImpactEvidence"));
end


// RECURSIVE BACKWARD CHAINING QUERIES

query reachesEvidence(String $child, String $target)
    EvidenceRelation(child == $child, parent == $target)
    or
    (
        EvidenceRelation(child == $child, $middle : parent)
        and
        reachesEvidence($middle, $target;)
    )
end

query supportsEvidence(String $studentId, String $child, String $target)
    EvidenceNode(studentId == $studentId, name == $child)
    reachesEvidence($child, $target;)
end

query hasAcademicBurnoutPattern(String $studentId)
    EvidenceNode(studentId == $studentId, name == "CoreBurnoutEvidence")
    EvidenceNode(studentId == $studentId, name == "ChronicityEvidence")
    EvidenceNode(studentId == $studentId, name == "AcademicImpactEvidence")

    supportsEvidence($studentId, "CoreBurnoutEvidence", "AcademicBurnoutPattern";)
    supportsEvidence($studentId, "ChronicityEvidence", "AcademicBurnoutPattern";)
    supportsEvidence($studentId, "AcademicImpactEvidence", "AcademicBurnoutPattern";)
end
